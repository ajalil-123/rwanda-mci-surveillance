# The ONE environment file for this repo. Copy to .env (gitignored) and fill in.
# Read by both scraper/ (jobs.py) and frontend/ (next.config.js).
# In production: the same keys go in Vercel → Settings → Environment Variables
# and in GitHub → Settings → Secrets → Actions (DATABASE_URL, ANTHROPIC_API_KEY).

# Neon → Connect → connection string (the pooled one works for both apps)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional — Claude checks each new article for Rwanda relevance
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=

# Signs the login JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Password-reset emails via https://resend.com (free tier). Without a key, local
# development prints the reset link in the `npm run dev` terminal instead.
RESEND_API_KEY=
EMAIL_FROM=NHIC MCI Surveillance <onboarding@resend.dev>

